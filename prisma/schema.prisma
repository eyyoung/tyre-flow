// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户管理 ====================

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String    // bcrypt 加密
  email         String?   @unique
  name          String?
  role          Role      @default(ADMIN)
  status        Status    @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 收集点绑定关系
  collectionPoints UserCollectionPoint[]
  isccExportJobs  IsccExportJob[]

  @@map("users")
}

enum Role {
  ADMIN // 超级管理员
  USER  // 收集点审核员
}

enum Status {
  ACTIVE
  DISABLED
}

// ==================== 收集点管理 ====================

model CollectionPoint {
  id                      String   @id @default(cuid())
  code                    String   @unique // 收集点编码
  name                    String            // 收集点名称（简称）
  nameTranslations        Json?    // { "en": "...", "fr": "...", "de": "..." }
  companyName             String?           // 收集点公司名（用于 ISCC 声明）
  companyNameTranslations Json?    // { "en": "...", "fr": "...", "de": "..." }
  address                 String
  addressTranslations     Json?    // { "en": "...", "fr": "...", "de": "..." }
  province                String?
  city                    String?
  cityTranslations        Json?    // { "en": "...", "fr": "...", "de": "..." }
  district                String?
  postcode                String?  // 邮编
  longitude               Float?
  latitude                Float?
  certScope               String?  // 认证范围
  contactName             String?
  contactPhone            String?
  status                  Status   @default(ACTIVE)
  translatedAt            DateTime?  // 翻译缓存时间
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  stores        Store[]
  vehicles      Vehicle[]
  users         UserCollectionPoint[]
  tasks         LedgerTask[]
  transferTasks TransferTask[]
  isccExportJobs IsccExportJob[]

  @@map("collection_points")
}

// 用户-收集点关联表（多对多）
model UserCollectionPoint {
  id                String          @id @default(cuid())
  userId            String
  collectionPointId String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([userId, collectionPointId])
  @@map("user_collection_points")
}

// ==================== 签名文件存储 ====================

model SignatureFile {
  id        String   @id @default(cuid())
  data      Bytes    // 签名图片二进制数据 (PNG)
  mimeType  String   @default("image/png")
  createdAt DateTime @default(now())

  store Store?

  @@map("signature_files")
}

// ==================== 门店管理 ====================

model Store {
  id                       String      @id @default(cuid())
  code                     String      @unique // 门店编码
  name                     String
  nameTranslations         Json?       // { "en": "...", "fr": "...", "de": "..." }
  businessLicense          String?     // 营业执照号（统一社会信用代码）
  legalPerson              String?     // 法人代表
  legalPersonTranslations  Json?       // { "en": "...", "fr": "...", "de": "..." }
  address                  String
  addressTranslations      Json?       // { "en": "...", "fr": "...", "de": "..." }
  province               String?
  city                   String?
  district               String?
  longitude              Float?
  latitude               Float?
  contactName            String?
  contactPhone           String?
  estimatedTravelMinutes Int         @default(0) // 到收集点的预估行程时间（分钟）
  status                 StoreStatus @default(ACTIVE)
  disabledAt             DateTime?
  disabledReason         String?
  isVirtual              Boolean     @default(true) // 是否虚拟生成
  collectionPointId      String
  collectionPoint        CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  signatureFileId        String?     @unique // ISCC 签名文件缓存
  signatureFile          SignatureFile? @relation(fields: [signatureFileId], references: [id], onDelete: SetNull)
  isccSignDate           DateTime?   // ISCC 声明签署日期缓存
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  collectionRecords CollectionRecord[]

  @@index([collectionPointId])
  @@index([status])
  @@map("stores")
}

enum StoreStatus {
  ACTIVE   // 正常
  DISABLED // 停用（注销/吊销/停业）
}

// ==================== 车辆管理 ====================

model Vehicle {
  id                      String      @id @default(cuid())
  plateNumber             String      @unique // 车牌号
  type                    VehicleType
  brand                   String?     // 品牌
  model                   String?     // 型号
  tareWeight              Float       // 皮重（kg）
  tareWeightVariance      Float       @default(0.05) // 皮重随机微调范围（kg）
  maxLoad                 Float       // 最大载重（kg）
  driverName              String?
  driverNameTranslations  Json?       // { "en": "...", "fr": "...", "de": "..." }
  driverPhone             String?
  collectionPointId  String
  collectionPoint    CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  status             Status      @default(ACTIVE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  collectionRecords CollectionRecord[]
  transferRecords   TransferRecord[]

  @@index([collectionPointId])
  @@index([type])
  @@map("vehicles")
}

enum VehicleType {
  COLLECTION // 收集车辆 4.2米
  TRANSFER   // 转移车辆 13米半挂
}

// ==================== 系统配置 ====================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String?  // 配置分类
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ==================== 工厂管理 ====================

model Factory {
  id        String   @id @default(cuid())
  name      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transferTasks TransferTask[]

  @@map("factories")
}

// ==================== 台账管理（Phase 3） ====================

model LedgerTask {
  id                        String          @id @default(cuid())
  taskNo                    String          @unique // 任务编号
  year                      Int?            // 保留兼容旧数据
  month                     Int?            // 保留兼容旧数据
  startDate                 DateTime        // 开始日期
  endDate                   DateTime        // 结束日期
  targetTonnage             Float           // 目标吨数
  actualTonnage             Float?          // 实际吨数（装车净重合计）
  unloadingTonnage          Float?          // 卸车净重合计
  totalLoss                 Float?          // 折损合计
  maxTripsPerVehiclePerDay  Int             @default(2) // 每车每日最大趟数
  status                    TaskStatus      @default(PENDING)
  errorMessage              String?
  startedAt                 DateTime?
  completedAt               DateTime?
  collectionPointId         String
  collectionPoint           CollectionPoint @relation(fields: [collectionPointId], references: [id])
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  collectionRecords CollectionRecord[]

  @@unique([collectionPointId, startDate, endDate])
  @@map("ledger_tasks")
}

// 转移任务（手动触发）
model TransferTask {
  id                 String          @id @default(cuid())
  taskNo             String          @unique // 任务编号
  startDate          DateTime        // 开始日期
  endDate            DateTime        // 结束日期
  targetTonnage      Float           // 目标重量（kg）
  actualTonnage      Float?          // 装车总重量（kg）
  unloadingTonnage   Float?          // 卸车总重量（kg）
  totalLoss          Float?          // 总折损（kg）
  status             TaskStatus      @default(PENDING)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  collectionPointId  String
  collectionPoint    CollectionPoint @relation(fields: [collectionPointId], references: [id])
  factoryId          String?
  factory            Factory?        @relation(fields: [factoryId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  transferRecords TransferRecord[]

  @@unique([collectionPointId, startDate, endDate])
  @@map("transfer_tasks")
}

enum TaskStatus {
  PENDING    // 待处理
  PROCESSING // 处理中
  COMPLETED  // 已完成
  FAILED     // 失败
}

// ==================== ISCC 异步导出任务 ====================

model IsccExportJob {
  id                String              @id @default(cuid())
  collectionPointId String
  collectionPoint   CollectionPoint     @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  requestedById     String?
  requestedBy       User?               @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  language          String              @default("en") // 自我声明统一按英文生成
  template          String              @default("PLUS_V1") // 模板版本，见 src/lib/iscc-templates.ts
  testMode          Boolean             @default(false) // 仅测试用：只导出前 N 家门店
  status            IsccExportJobStatus @default(PENDING)
  phase             String              @default("queued")
  progress          Int                 @default(0)
  processed         Int                 @default(0)
  total             Int                 @default(0)
  fileName          String?
  filePath          String?
  fileType          String?
  fileSize          Int?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([collectionPointId, createdAt])
  @@map("iscc_export_jobs")
}

enum IsccExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

// 收集记录（门店→收集点）
model CollectionRecord {
  id                 String     @id @default(cuid())
  recordNo           String     @unique // 记录编号
  taskId             String
  task               LedgerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storeId            String
  store              Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  collectionDate     DateTime   // 收集日期
  loadingTime        DateTime   // 装车时间（精确到分）
  unloadingTime      DateTime?  // 卸车时间（精确到分），只有最后一站才有
  tireCount          Int        // 轮胎条数
  loadingNetWeight   Float      // 装车净重（kg）
  unloadingNetWeight Float      // 卸车净重（kg）
  loss               Float      // 折损（kg）
  remarks            String?
  createdAt          DateTime   @default(now())

  @@index([taskId])
  @@index([storeId])
  @@index([collectionDate])
  @@map("collection_records")
}

// 转移记录（收集点→工厂）
model TransferRecord {
  id                 String       @id @default(cuid())
  recordNo           String       @unique // 记录编号
  taskId             String
  task               TransferTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transferDate       DateTime     // 转移日期
  destination        String       // 目的地（工厂）
  tireCount          Int          // 轮胎条数
  loadingNetWeight   Float        // 装车净重（kg）
  grossWeight        Float        // 卸车毛重（kg）
  tareWeight         Float        // 皮重（kg）
  unloadingNetWeight Float        // 卸车净重（kg）
  loss               Float        // 折损（kg）
  weighbridgeNo      String?      // 磅单号
  remarks            String?
  createdAt          DateTime     @default(now())

  @@index([taskId])
  @@index([transferDate])
  @@map("transfer_records")
}
